# Catalogy server environment.
#   System service: copy to /etc/catalogy/catalogy.env
#   User service:   copy to ~/.config/catalogy/catalogy.env
# Keep this file readable only by the service user (chmod 600) as a habit.

# Port the HTTP server listens on. Consumed by the unit's ExecStart line
# (systemd substitutes it into `--port`). The in-binary default is 18080;
# 8080 is intentionally avoided (it collides with llama-swap on thebeast).
CATALOGY_PORT=18080

# --- Strictly-offline operation (project invariant) ----------------------
# The Rust server loads local ONNX weights and makes no network calls, so
# these are belt-and-suspenders — they guarantee nothing reaches a model hub
# even if a code path ever tried. Keep them set; it matches project policy.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
no_proxy=*
NO_PROXY=*

# --- Optional overrides (uncomment to set) -------------------------------
# Directory holding the ONNX model files: visual.onnx, text.onnx,
# tokenizer.json. If unset, catalogy uses its default model directory and
# search is disabled until the files are present.
#CATALOGY_MODEL_DIR=/home/REPLACE_WITH_USER/.local/share/catalogy/models

# Log verbosity: error | warn | info | debug | trace (default: info).
#RUST_LOG=info
